{
  "name": "cryptpass",
  "version": "0.1.0",
  "description": "Simply encrypt passwords (on file)",
  "main": "dist/crypt.js",
  "types": "dist/crypt.d.ts",
  "type": "commonjs",
  "scripts": {
    "test": "npm run build && node tests/security.test.js",
    "build": "rm -rf ./dist && tsc",
    "bundle": "esbuild dist/crypt.js --bundle --platform=browser --format=iife --global-name=LibCryptPass --define:global=globalThis --inject:scripts/browser-globals.js --alias:stream=stream-browserify --alias:events=events --outfile=dist/LibCryptPass.js",
    "benchmark:browser": "npm run build && npm run bundle && esbuild scripts/browser-kdf-benchmark-worker.js --bundle --platform=browser --format=iife --define:global=globalThis --inject:scripts/browser-globals.js --alias:stream=stream-browserify --alias:events=events --outfile=dist/kdf-benchmark-worker.js && node scripts/serve-browser-benchmark.js"
  },
  "author": "Giancarlo Mangiagli",
  "license": "MIT",
  "dependencies": {
    "browser-resolve": "^2.0.0",
    "browserify-aes": "^1.2.0",
    "buffer": "^6.0.3",
    "randombytes": "^2.1.0",
    "scrypt-js": "^3.0.1",
    "stream-browserify": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "esbuild": "^0.28.2",
    "events": "^3.3.0",
    "process": "^0.11.10"
  }
}
